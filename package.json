{
  "name": "maas-admin-console-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "示範用 MaaS 平台管理主控台（借用 Azure RBAC 概念與 Fluent 2 設計語言，非官方 Azure Portal）",
  "scripts": {
    "dev": "vite",
    "dev:customer": "vite --mode customer --port 5173",
    "dev:admin": "vite --mode admin --port 5174",
    "live": "node scripts/live.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode customer && vite build --mode admin",
    "build:customer": "vite build --mode customer",
    "build:admin": "vite build --mode admin",
    "build:combined": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "preview:customer": "vite preview --outDir dist-customer --port 5183",
    "preview:admin": "vite preview --outDir dist-admin --port 5184",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
